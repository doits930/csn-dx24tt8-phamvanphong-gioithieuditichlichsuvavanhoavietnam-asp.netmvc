@model HomeVM
@{
    ViewData["Title"] = "Trang chủ";
    var summaryLine = Model.Stats.RelicCount > 0
        ? $"Hiện có {Model.Stats.RelicCount} di tích ở {Model.Stats.ProvinceHavingRelicCount} tỉnh thành, chia theo {Model.Stats.RelicTypeCount} loại."
        : $"Dữ liệu di tích đang được biên soạn. Danh mục hiện có {Model.Stats.ProvinceCount} tỉnh thành và {Model.Stats.RelicTypeCount} loại di tích.";
    var featured = Model.Showcase.Featured;
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 @(Model.Showcase.HeroHighlights.Count > 0 ? "col-lg-5" : "col-lg-8")">
                <h1>Tra cứu di tích lịch sử và văn hóa Việt Nam</h1>
                <p class="hero-lede">Vị trí, lịch sử hình thành và thông tin tham quan của những di tích đã được xếp hạng, mỗi bản ghi đều dẫn nguồn.</p>
                <form class="search-form search-form-large" action="/di-tich" method="get" role="search" data-search-form>
                    <label class="visually-hidden" for="search-home">Tìm di tích theo tên</label>
                    <input type="search" id="search-home" name="tuKhoa"
                           placeholder="Ví dụ: Đền Hùng" maxlength="200" />
                    <button type="submit" class="btn-accent">Tìm</button>
                </form>
                <p class="summary-line">@summaryLine</p>
            </div>
            @if (Model.Showcase.HeroHighlights.Count > 0)
            {
                <div class="col-12 col-lg-7 hero-visual">
                    <partial name="_HeroMosaic" model="Model.Showcase.HeroHighlights" />
                </div>
            }
        </div>
    </div>
</section>

<section class="page-section">
    <div class="container">
        <h2 class="page-section-title">Di tích tiêu biểu</h2>
        @if (featured.Count > 0)
        {
            <div class="featured-grid">
                @for (var i = 0; i < featured.Count; i++)
                {
                    <partial name="@(i == 0 ? "_RelicCardLead" : "_RelicCard")" model="featured[i]" />
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>Chưa có di tích nào để giới thiệu.</p>
                <p>Danh mục tỉnh thành và loại di tích đã sẵn sàng; các bản ghi di tích sẽ hiện tại đây ngay khi được nạp vào cơ sở dữ liệu.</p>
            </div>
        }
    </div>
</section>

@if (Model.RelicTypes.Count > 0)
{
    <section class="page-section">
        <div class="container">
            <h2 class="page-section-title">Theo loại di tích</h2>
            <div class="row g-4">
                @foreach (var type in Model.RelicTypes)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <a class="type-tile @(string.IsNullOrWhiteSpace(type.CoverImagePath) ? "type-tile-plain" : string.Empty)"
                           href="/loai/@type.Slug">
                            @if (!string.IsNullOrWhiteSpace(type.CoverImagePath))
                            {
                                <img src="@type.CoverImagePath" alt="" loading="lazy" decoding="async"
                                     onerror="this.src='/img/no-image.svg'" />
                            }
                            <span class="type-tile-caption">
                                <span class="type-tile-name">@type.Name</span>
                                <span class="type-tile-count">@(type.RelicCount > 0 ? $"{type.RelicCount} di tích" : "Chưa có di tích")</span>
                            </span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Model.Regions.Count > 0)
{
    <section class="province-band">
        <div class="container">
            <h2 class="page-section-title">Theo tỉnh thành</h2>
            <partial name="_ProvinceDirectory" model="Model.Regions" />
        </div>
    </section>
}
