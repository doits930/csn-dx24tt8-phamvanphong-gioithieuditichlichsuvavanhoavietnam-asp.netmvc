@model HomeVM
@{
    ViewData["Title"] = "Trang chủ";
    var featured = Model.Showcase.Featured;
}

<section class="home-hero">
    @if (Model.Showcase.HeroSlides.Count > 0)
    {
        <partial name="_HeroLookbook" model="Model.Showcase.HeroSlides" />
    }
    else
    {
        <div class="lookbook lookbook-plain">
            <div class="container">
                <h1 class="lookbook-name lookbook-name-medium">Tra cứu di tích lịch sử và văn hóa Việt Nam</h1>
                <p class="lookbook-intro">Dữ liệu di tích đang được biên soạn. Ô tìm kiếm bên dưới sẽ có kết quả ngay khi những bản ghi đầu tiên được nạp vào.</p>
            </div>
        </div>
    }

    <div class="container home-hero-search">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">
                <partial name="_SearchBar" model="Model.SearchBar" />
            </div>
        </div>
    </div>
</section>

<section class="page-section page-section-after-hero">
    <div class="container">
        <h2 class="page-section-title">Di tích tiêu biểu</h2>
        @if (featured.Count > 0)
        {
            <div class="featured-grid">
                @for (var i = 0; i < featured.Count; i++)
                {
                    <partial name="@(i == 0 ? "_RelicCardLead" : "_RelicCard")" model="featured[i]" />
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>Chưa có di tích nào để giới thiệu.</p>
                <p>Danh mục tỉnh thành và loại di tích đã sẵn sàng; các bản ghi di tích sẽ hiện tại đây ngay khi được nạp vào cơ sở dữ liệu.</p>
            </div>
        }
    </div>
</section>

@if (Model.RelicTypes.Count > 0)
{
    <section class="page-section">
        <div class="container">
            <h2 class="page-section-title">Theo loại di tích</h2>
            <div class="row g-4">
                @foreach (var type in Model.RelicTypes)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <a class="type-tile @(string.IsNullOrWhiteSpace(type.CoverImagePath) ? "type-tile-plain" : string.Empty)"
                           href="/loai/@type.Slug">
                            @if (!string.IsNullOrWhiteSpace(type.CoverImagePath))
                            {
                                <img src="@type.CoverImagePath" alt="" loading="lazy" decoding="async"
                                     onerror="this.src='/img/no-image.svg'" />
                            }
                            <span class="type-tile-caption">
                                <span class="type-tile-name">@type.Name</span>
                                <span class="type-tile-count">@(type.RelicCount > 0 ? $"{type.RelicCount} mục" : "Chưa có mục nào")</span>
                            </span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Model.Regions.Count > 0)
{
    <section class="province-band">
        <div class="container">
            <h2 class="page-section-title">Theo tỉnh thành</h2>
            <div class="row g-4 province-layout">
                <div class="col-12 col-lg-5">
                    <partial name="_VietnamMap" model="Model.Map" />
                </div>
                <div class="col-12 col-lg-7">
                    <partial name="_ProvinceDirectory" model="Model.Regions" />
                </div>
            </div>
        </div>
    </section>
}

@section Scripts {
    <script src="~/js/hero-lookbook.js" asp-append-version="true"></script>
    <script src="~/js/province-map.js" asp-append-version="true"></script>
}
