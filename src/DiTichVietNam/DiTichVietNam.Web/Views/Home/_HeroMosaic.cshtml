@model List<RelicCardVM>
@{
    const int EagerTileCount = 3;
    var layoutModifier = Model.Count == 5 ? "hero-mosaic-woven" : "hero-mosaic-even";
}

@if (Model.Count > 0)
{
    <div class="hero-mosaic @layoutModifier">
        @for (var i = 0; i < Model.Count; i++)
        {
            var relic = Model[i];
            <a class="hero-tile" href="/di-tich/@relic.Slug">
                <img src="@(string.IsNullOrWhiteSpace(relic.ThumbnailPath) ? "/img/no-image.svg" : relic.ThumbnailPath)" alt="@relic.Name" decoding="async"
                     loading="@(i < EagerTileCount ? "eager" : "lazy")"
                     fetchpriority="@(i == 0 ? "high" : "auto")"
                     onerror="this.src='/img/no-image.svg'" />
                <span class="hero-tile-caption">
                    <span class="hero-tile-name">@relic.Name</span>
                    <span class="hero-tile-province">@relic.ProvinceName</span>
                </span>
            </a>
        }
    </div>
}
