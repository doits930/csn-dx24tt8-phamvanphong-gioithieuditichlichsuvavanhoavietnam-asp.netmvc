@{
    var hideNavSearch = ViewData["HideNavSearch"] as bool? ?? false;
    var metaDescription = ViewData["MetaDescription"] as string;
}
<!DOCTYPE html>
<html lang="vi" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Di tích Việt Nam</title>
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>document.documentElement.classList.remove('no-js');</script>
</head>
<body>
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng, vào nội dung chính</a>
    <partial name="_BackToTop" />
    <span class="header-sentinel" aria-hidden="true" data-header-sentinel></span>

    <header class="site-header">
        @await Component.InvokeAsync("MainMenu", new { showSearch = !hideNavSearch })
    </header>

    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer-grid">
                <div>
                    <p class="project-title">Website giới thiệu di tích lịch sử và văn hóa Việt Nam</p>
                    <p>Đồ án cơ sở ngành của sinh viên Phạm Văn Phong, mã số sinh viên 170124953, lớp DX24TT8.</p>
                </div>
                <p class="footer-note">Ảnh trên trang chủ dùng để nhận diện di tích. Nguồn của từng ảnh ghi đầy đủ ở trang chi tiết của di tích đó.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site-shell.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/search-bar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
