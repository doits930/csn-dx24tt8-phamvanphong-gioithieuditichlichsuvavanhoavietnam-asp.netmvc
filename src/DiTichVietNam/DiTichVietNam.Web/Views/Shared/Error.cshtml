@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="container">
    <section class="page-section">
        <h1 class="page-section-title">Đã xảy ra lỗi</h1>
        <p>
            Yêu cầu vừa rồi không xử lý được. Bạn thử tải lại trang, hoặc quay về
            <a href="/">trang chủ</a> để bắt đầu lại.
        </p>
        @if (Model.ShowRequestId)
        {
            <p class="summary-line">Mã yêu cầu: @Model.RequestId</p>
        }
    </section>
</div>
