@model AdminUserPasswordVM
@{
    var listUrl = AdminUserController.ListPath;
    var cancelUrl = string.IsNullOrEmpty(Model.ReturnUrl) ? listUrl : Model.ReturnUrl;
    var formAction = AdminUserController.ResetPasswordUrl(Model.Id);

    ViewData["AdminCrumbs"] = new List<AdminCrumb>
    {
        new() { Label = "Quản trị", Url = DashboardController.IndexPath },
        new() { Label = "Tài khoản", Url = listUrl },
        new() { Label = "Đặt lại mật khẩu" }
    };

    var header = new AdminPageHeaderVM
    {
        Title = "Đặt lại mật khẩu",
        Lead = $"Đặt mật khẩu mới cho tài khoản {Model.Email}. Mật khẩu cũ mất hiệu lực ngay và phiên đang mở của tài khoản đó bị đăng xuất.",
        Links = Model.IsLocked
            ? new List<AdminPageLinkVM>
            {
                new() { Label = "Danh sách tài khoản", Url = listUrl, Icon = "user" }
            }
            : new List<AdminPageLinkVM>()
    };

    var fieldOrder = new (string Field, string TargetId)[]
    {
        (nameof(Model.Password), "field-password"),
        (nameof(Model.ConfirmPassword), "field-confirm-password")
    };

    var summary = AdminErrorSummaryVM.FromModelState(ViewData.ModelState, fieldOrder);

    var passwordField = new AdminPasswordFieldVM
    {
        FieldId = "field-password",
        Name = nameof(Model.Password),
        Label = "Mật khẩu mới",
        Rules = Model.PasswordRules,
        Error = ViewData.ModelState[nameof(Model.Password)]?.Errors.FirstOrDefault()?.ErrorMessage
    };

    var confirmField = new AdminPasswordFieldVM
    {
        FieldId = "field-confirm-password",
        Name = nameof(Model.ConfirmPassword),
        Label = "Nhập lại mật khẩu mới",
        Error = ViewData.ModelState[nameof(Model.ConfirmPassword)]?.Errors.FirstOrDefault()?.ErrorMessage
    };
}

<partial name="_AdminPageHeader" model="header" />

<form id="account-form" class="admin-form admin-form-narrow" action="@formAction" method="post"
      autocomplete="off" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

    <partial name="_AdminErrorSummary" model="summary" />

    <p class="admin-form-legend">Ô có dấu <span class="admin-required">*</span> là bắt buộc.</p>

    <section class="admin-card admin-card-pad">
        <div class="admin-card-head">
            <h2 class="admin-card-title">
                <partial name="_AdminIcon" model="@("key")" />
                <span>Mật khẩu mới</span>
            </h2>
            <p class="admin-card-note">Báo mật khẩu mới cho người dùng tài khoản này bằng kênh liên lạc riêng.</p>
        </div>

        <ul class="admin-fact-list">
            <li>
                <span class="admin-fact-label">Tài khoản</span>
                <span class="admin-fact-value">@Model.Email</span>
            </li>
        </ul>

        @if (Model.IsLocked)
        {
            <p class="admin-notice admin-notice-warning" role="status">
                Tài khoản này đang bị khóa. Đặt lại mật khẩu không mở khóa tài khoản.
            </p>
        }

        <partial name="_AdminPasswordField" model="passwordField" />
        <partial name="_AdminPasswordField" model="confirmField" />
    </section>

    <div class="admin-form-footer">
        <div class="admin-form-actions">
            <span class="admin-form-state" data-form-state aria-live="polite"></span>
            <a class="admin-btn admin-btn-secondary" href="@cancelUrl" data-discard>Hủy</a>
            <button type="submit" class="admin-btn admin-btn-primary" data-submit-button>Đặt lại mật khẩu</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/js/admin/account-form.js" asp-append-version="true"></script>
}
