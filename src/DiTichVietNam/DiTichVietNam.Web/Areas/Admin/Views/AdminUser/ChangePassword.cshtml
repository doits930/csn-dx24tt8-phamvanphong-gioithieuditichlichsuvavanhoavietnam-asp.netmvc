@model ChangePasswordVM
@{
    var listUrl = AdminUserController.ListPath;

    ViewData["AdminCrumbs"] = new List<AdminCrumb>
    {
        new() { Label = "Quản trị", Url = DashboardController.IndexPath },
        new() { Label = "Đổi mật khẩu" }
    };

    var header = new AdminPageHeaderVM
    {
        Title = "Đổi mật khẩu",
        Lead = "Đổi mật khẩu của tài khoản bạn đang đăng nhập. Phiên hiện tại vẫn giữ, những phiên khác bị đăng xuất."
    };

    var fieldOrder = new (string Field, string TargetId)[]
    {
        (nameof(Model.CurrentPassword), "field-current-password"),
        (nameof(Model.NewPassword), "field-new-password"),
        (nameof(Model.ConfirmPassword), "field-confirm-password")
    };

    var summary = AdminErrorSummaryVM.FromModelState(ViewData.ModelState, fieldOrder);

    var currentField = new AdminPasswordFieldVM
    {
        FieldId = "field-current-password",
        Name = nameof(Model.CurrentPassword),
        Label = "Mật khẩu hiện tại",
        Autocomplete = "current-password",
        Error = ViewData.ModelState[nameof(Model.CurrentPassword)]?.Errors.FirstOrDefault()?.ErrorMessage
    };

    var newField = new AdminPasswordFieldVM
    {
        FieldId = "field-new-password",
        Name = nameof(Model.NewPassword),
        Label = "Mật khẩu mới",
        Rules = Model.PasswordRules,
        Error = ViewData.ModelState[nameof(Model.NewPassword)]?.Errors.FirstOrDefault()?.ErrorMessage
    };

    var confirmField = new AdminPasswordFieldVM
    {
        FieldId = "field-confirm-password",
        Name = nameof(Model.ConfirmPassword),
        Label = "Nhập lại mật khẩu mới",
        Error = ViewData.ModelState[nameof(Model.ConfirmPassword)]?.Errors.FirstOrDefault()?.ErrorMessage
    };
}

<partial name="_AdminPageHeader" model="header" />

<form id="account-form" class="admin-form admin-form-narrow" action="@AdminUserController.ChangePasswordPath"
      method="post" autocomplete="off" novalidate>
    @Html.AntiForgeryToken()

    <partial name="_AdminErrorSummary" model="summary" />

    <p class="admin-form-legend">Ô có dấu <span class="admin-required">*</span> là bắt buộc.</p>

    <section class="admin-card admin-card-pad">
        <div class="admin-card-head">
            <h2 class="admin-card-title">
                <partial name="_AdminIcon" model="@("key")" />
                <span>Mật khẩu của bạn</span>
            </h2>
            <p class="admin-card-note">Nhập sai mật khẩu hiện tại nhiều lần thì tài khoản tạm khóa như khi đăng nhập.</p>
        </div>

        <ul class="admin-fact-list">
            <li>
                <span class="admin-fact-label">Tài khoản</span>
                <span class="admin-fact-value">@Model.AccountEmail</span>
            </li>
        </ul>

        <partial name="_AdminPasswordField" model="currentField" />
        <partial name="_AdminPasswordField" model="newField" />
        <partial name="_AdminPasswordField" model="confirmField" />
    </section>

    <div class="admin-form-footer">
        <div class="admin-form-actions">
            <span class="admin-form-state" data-form-state aria-live="polite"></span>
            <a class="admin-btn admin-btn-secondary" href="@listUrl" data-discard>Hủy</a>
            <button type="submit" class="admin-btn admin-btn-primary" data-submit-button>Đổi mật khẩu</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/js/admin/account-form.js" asp-append-version="true"></script>
}
