@model ProvinceListVM
@inject IOptions<AdminSiteOptions> AdminSite
@{
    var publicPort = AdminSite.Value.PublicPort;
    var listUrl = Model.ListUrl;
    var createUrl = $"/admin/tinh-thanh/them?returnUrl={Uri.EscapeDataString(listUrl)}";

    ViewData["AdminCrumbs"] = new List<AdminCrumb>
    {
        new() { Label = "Quản trị", Url = DashboardController.IndexPath },
        new() { Label = "Tỉnh thành" }
    };

    var header = new AdminPageHeaderVM
    {
        Title = "Quản lý tỉnh thành",
        Lead = "Danh mục 34 tỉnh thành hiện hành. Đổi tên một tỉnh thành không làm đổi địa chỉ công khai của nó.",
        ActionLabel = "Thêm tỉnh thành",
        ActionUrl = createUrl,
        ActionIcon = "plus"
    };

    var confirmDialog = new AdminConfirmVM
    {
        ElementId = "delete-province-dialog",
        Title = "Xóa tỉnh thành",
        ConfirmLabel = "Xóa tỉnh thành",
        CancelLabel = "Hủy"
    };

    var stats = new (string Icon, string IconClass, int Value, string Label)[]
    {
        ("province", "admin-stat-icon", Model.Summary.TotalCount, "Tổng tỉnh thành"),
        ("relic", "admin-stat-icon admin-stat-icon-gilt", Model.Summary.WithRelicCount, "Đã có di tích"),
        ("search", "admin-stat-icon admin-stat-icon-stone", Model.Summary.WithoutRelicCount, "Chưa có di tích"),
        ("compass", "admin-stat-icon admin-stat-icon-vermilion", Model.Summary.WithoutMapCount, "Chưa có trên bản đồ")
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="admin-stats">
    @foreach (var stat in stats)
    {
        <div class="admin-stat">
            <span class="@stat.IconClass">
                <partial name="_AdminIcon" model="@stat.Icon" />
            </span>
            <span>
                <span class="admin-stat-value">@stat.Value</span>
                <span class="admin-stat-label">@stat.Label</span>
            </span>
        </div>
    }
</div>

<div class="admin-card">
    <form class="admin-toolbar" action="/admin/tinh-thanh" method="get" role="search">
        <div class="admin-toolbar-field admin-toolbar-keyword">
            <label for="filter-keyword">Tìm tỉnh thành</label>
            <div class="admin-search-box">
                <partial name="_AdminIcon" model="@("search")" />
                <input type="search" id="filter-keyword" name="@SearchFilterVM.KeywordKey"
                       value="@Model.Keyword" maxlength="100" placeholder="Gõ có dấu hay không dấu đều được" />
            </div>
        </div>
        <div class="admin-toolbar-actions">
            <button type="submit" class="admin-btn admin-btn-primary">Tìm</button>
            @if (Model.HasKeyword)
            {
                <a class="admin-btn-text" href="/admin/tinh-thanh">Xóa tìm kiếm</a>
            }
        </div>
    </form>

    @if (Model.Rows.Count == 0)
    {
        <div class="admin-empty">
            <partial name="_AdminIcon" model="@("search")" />
            <p class="admin-empty-text">
                @(Model.HasKeyword
                    ? "Không có tỉnh thành nào khớp từ khóa đang gõ."
                    : "Danh mục tỉnh thành đang trống. Thêm tỉnh thành đầu tiên để bắt đầu.")
            </p>
            @if (Model.HasKeyword)
            {
                <a class="admin-btn admin-btn-secondary" href="/admin/tinh-thanh">Xóa tìm kiếm</a>
            }
            else
            {
                <a class="admin-btn admin-btn-primary" href="@createUrl">Thêm tỉnh thành</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive admin-table-wrap">
            <table class="admin-table">
                <caption class="admin-visually-hidden">Danh mục tỉnh thành đang có trong hệ thống</caption>
                <thead>
                    <tr>
                        <th scope="col">Tên tỉnh thành</th>
                        <th scope="col">Miền</th>
                        <th scope="col" class="admin-cell-number">Di tích</th>
                        <th scope="col">Bản đồ trang chủ</th>
                        <th scope="col" class="admin-cell-actions"><span class="admin-visually-hidden">Thao tác</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var editUrl = $"/admin/tinh-thanh/sua/{row.Id}?returnUrl={Uri.EscapeDataString(listUrl)}";
                        var deleteUrl = $"/admin/tinh-thanh/xoa/{row.Id}?returnUrl={Uri.EscapeDataString(listUrl)}";
                        var relicUrl = $"/admin/di-tich?{SearchFilterVM.ProvinceKey}={row.Slug}";
                        var publicUrl = SiteUrls.OnPort(Context.Request, publicPort, $"/tinh/{row.Slug}");
                        var blockReason = ProvinceFactory.DeleteBlockReason(row.RelicCount, row.HasMapShape);
                        var confirmText = $"Xóa tỉnh thành {row.Name}? Thao tác này không lấy lại được.";
                        <tr>
                            <td class="admin-cell-name">
                                <a class="admin-row-name" href="@editUrl">@row.Name</a>
                                <span class="admin-row-slug">@row.Slug</span>
                                @if (blockReason is not null)
                                {
                                    <span class="admin-blocked-note" id="province-@(row.Id)-note">@blockReason</span>
                                }
                            </td>
                            <td data-label="Miền">
                                <span class="admin-chip admin-chip-outline">@row.RegionLabel</span>
                            </td>
                            <td data-label="Di tích" class="admin-cell-number">
                                <a class="@(row.RelicCount > 0 ? "admin-count-link" : "admin-count-link admin-count-empty")"
                                   href="@relicUrl"
                                   title="@(row.RelicCount > 0 ? $"Xem {row.RelicCount} di tích thuộc {row.Name}" : "Chưa có di tích nào")">@row.RelicCount</a>
                            </td>
                            <td data-label="Bản đồ trang chủ">
                                @if (row.HasMapShape)
                                {
                                    <span class="admin-map-state">Đã vẽ</span>
                                }
                                else
                                {
                                    <span class="admin-chip map-absent">Chưa có trên bản đồ</span>
                                }
                            </td>
                            <td class="admin-cell-actions">
                                <span class="admin-row-actions">
                                    <a class="admin-icon-btn" href="@editUrl" title="Sửa tỉnh thành"
                                       aria-label="Sửa tỉnh thành @row.Name">
                                        <partial name="_AdminIcon" model="@("edit")" />
                                    </a>
                                    <a class="admin-icon-btn" href="@relicUrl" title="Xem di tích thuộc @row.Name"
                                       aria-label="Xem di tích thuộc @row.Name">
                                        <partial name="_AdminIcon" model="@("list")" />
                                    </a>
                                    <a class="admin-icon-btn" href="@publicUrl" target="_blank" rel="noopener"
                                       title="Mở trang công khai trong tab mới"
                                       aria-label="Mở trang công khai của @row.Name">
                                        <partial name="_AdminIcon" model="@("external")" />
                                    </a>
                                    @if (blockReason is null)
                                    {
                                        <a class="admin-icon-btn admin-icon-btn-danger" href="@deleteUrl"
                                           title="Xóa tỉnh thành" aria-label="Xóa tỉnh thành @row.Name"
                                           data-delete-trigger
                                           data-delete-url="@deleteUrl"
                                           data-delete-message="@confirmText">
                                            <partial name="_AdminIcon" model="@("trash")" />
                                        </a>
                                    }
                                    else
                                    {
                                        <partial name="_AdminBlockedButton" model="@(new AdminBlockedButtonVM
                                        {
                                            NoteId = $"province-{row.Id}-note",
                                            Icon = "trash",
                                            Label = "Xóa tỉnh thành",
                                            Subject = row.Name
                                        })" />
                                    }
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-card-foot">
            <p class="admin-result-count" role="status">@Model.ResultSummary</p>
        </div>
    }
</div>

@if (Model.Rows.Count > 0)
{
    <partial name="_AdminConfirmDialog" model="confirmDialog" />
}

@section Scripts {
    <script src="~/js/admin/admin-confirm.js" asp-append-version="true"></script>
}
