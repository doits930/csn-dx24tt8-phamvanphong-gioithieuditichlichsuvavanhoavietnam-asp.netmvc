@model AdminPasswordFieldVM
@{
    var errorId = $"{Model.FieldId}-error";
    var rulesId = $"{Model.FieldId}-rules";
    var describedBy = Model.HasRules
        ? (Model.Error is null ? rulesId : $"{rulesId} {errorId}")
        : (Model.Error is null ? null : errorId);
}

<div class="@(Model.Error is null ? "admin-field" : "admin-field admin-field-invalid")">
    <label for="@Model.FieldId">@Model.Label <span class="admin-required" aria-hidden="true">*</span></label>
    <div class="admin-password">
        <input type="password" id="@Model.FieldId" name="@Model.Name" maxlength="100"
               autocomplete="@Model.Autocomplete" spellcheck="false"
               aria-invalid="@(Model.Error is null ? "false" : "true")"
               aria-describedby="@describedBy" />
        <button type="button" class="admin-password-toggle" data-password-toggle
                aria-pressed="false" aria-controls="@Model.FieldId">Hiện</button>
    </div>
    @if (Model.HasRules)
    {
        <div class="password-rules" id="@rulesId" data-password-rules data-password-for="@Model.FieldId">
            <p class="password-rules-title">Mật khẩu cần đạt</p>
            <ul class="password-rule-list">
                @foreach (var rule in Model.Rules)
                {
                    <li class="password-rule" data-rule="@rule.Code" data-rule-value="@rule.Threshold"
                        data-rule-label="@rule.ShortLabel">
                        <span class="password-rule-mark" aria-hidden="true"></span>
                        <span class="password-rule-text">@rule.Description</span>
                    </li>
                }
            </ul>
            <p class="admin-visually-hidden" role="status" data-password-status></p>
        </div>
    }
    @if (Model.Error is not null)
    {
        <p class="field-error" id="@errorId">@Model.Error</p>
    }
</div>
