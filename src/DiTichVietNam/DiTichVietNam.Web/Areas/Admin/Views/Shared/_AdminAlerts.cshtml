@{
    var successMessage = TempData["AdminSuccess"] as string;
    var errorMessage = TempData["AdminError"] as string;
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="admin-alert admin-alert-success" role="status">
        <partial name="_AdminIcon" model="@("check")" />
        <p class="admin-alert-text">@successMessage</p>
        <button type="button" class="admin-alert-close" data-alert-close aria-label="Đóng thông báo">
            <partial name="_AdminIcon" model="@("close")" />
        </button>
    </div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="admin-alert admin-alert-error" role="alert">
        <partial name="_AdminIcon" model="@("alert")" />
        <p class="admin-alert-text">@errorMessage</p>
        <button type="button" class="admin-alert-close" data-alert-close aria-label="Đóng thông báo">
            <partial name="_AdminIcon" model="@("close")" />
        </button>
    </div>
}
