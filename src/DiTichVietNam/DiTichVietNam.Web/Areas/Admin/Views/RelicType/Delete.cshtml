@model RelicTypeDeleteVM
@{
    var returnQuery = string.IsNullOrEmpty(Model.ReturnUrl)
        ? string.Empty
        : $"?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
    var cancelUrl = string.IsNullOrEmpty(Model.ReturnUrl) ? "/admin/loai-di-tich" : Model.ReturnUrl;
    var relicUrl = $"/admin/di-tich?{SearchFilterVM.TypeKey}={Model.Slug}";

    ViewData["AdminCrumbs"] = new List<AdminCrumb>
    {
        new() { Label = "Quản trị", Url = DashboardController.IndexPath },
        new() { Label = "Loại di tích", Url = "/admin/loai-di-tich" },
        new() { Label = "Xóa loại di tích" }
    };

    var header = new AdminPageHeaderVM
    {
        Title = "Xóa loại di tích",
        Lead = $"Xóa loại di tích {Model.Name} khỏi danh mục."
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="admin-card admin-card-pad admin-state-card">
    <partial name="_AdminIcon" model="@("alert")" />

    @if (Model.IsBlocked)
    {
        <p class="admin-panel-text">@Model.BlockReason</p>
        <div class="admin-panel-actions">
            <a class="admin-btn admin-btn-secondary" href="@cancelUrl">Quay lại danh sách</a>
            @if (Model.RelicCount > 0)
            {
                <a class="admin-btn admin-btn-primary" href="@relicUrl">Xem @Model.RelicCount di tích</a>
            }
        </div>
    }
    else
    {
        <p class="admin-panel-text">
            Chưa có di tích nào dùng loại này. Sau khi xóa, loại này biến mất khỏi bộ lọc công khai và biểu mẫu di tích.
            Thao tác này không lấy lại được.
        </p>
        <form class="admin-panel-actions" action="/admin/loai-di-tich/xoa/@Model.Id@returnQuery" method="post">
            @Html.AntiForgeryToken()
            <a class="admin-btn admin-btn-secondary" href="@cancelUrl">Hủy</a>
            <button type="submit" class="admin-btn admin-btn-danger">Xóa loại di tích</button>
        </form>
    }
</div>
